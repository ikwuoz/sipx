# Required for seller proxy
NEAR_AI_API_KEY=your_near_ai_cloud_api_key
SELLER_ACCOUNT_ID=your-seller.near

# Optional seller proxy config
PORT=4020
HOST=0.0.0.0
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://free.rpc.fastnear.com
UPSTREAM_BASE_URL=https://cloud-api.near.ai/v1
DEFAULT_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# HMAC secret for signing near402_ session tokens (auto-generated ephemerally if unset)
SESSION_SECRET=change-me-to-a-long-random-hex-secret

# Pricing & top-up defaults
MARKUP_BPS=1000
MIN_TOPUP_USD=0.01
SUGGESTED_TOPUP_USD=0.10
FREE_ALLOWANCE_USD=0

# Optional 1Click API JWT (reduces 1Click swap fee from 0.25% to 0.01%-0.20%)
ONECLICK_API_KEY=

# Optional persistence path for session credits & redeemed tx hashes
LEDGER_PATH=./data/ledger.json

# Buyer demo / CLI env vars
NEAR402_PROXY_URL=http://localhost:4020
NEAR_ACCOUNT_ID=your-agent.near
NEAR_PRIVATE_KEY=ed25519:...

